# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version

# Data (regenerable / large — never commit)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Reports output (plots/artifacts regenerated by code) — but hand-maintained
# markdown reports (e.g. FINDINGS.md) are tracked, not regenerable
reports/*
!reports/.gitkeep
!reports/*.md
# Exception: the live app (src/app) reads this at request time and has no access to the raw
# historical data needed to regenerate it (data/ is gitignored, not shipped to Render) -- same
# "committed because the deployed app needs it" reasoning as models_registry/. Refresh with
# `uv run python -m edf.models.history_comparison`.
!reports/ndf_comparison_last_year.csv

# Secrets
.env

# MLflow experiment tracking (local file store — regenerated by rerunning
# the experiment notebooks, same as data/ and reports/)
mlruns/
mlartifacts/

# Jupyter
.ipynb_checkpoints/

# IDE
.idea/
